<svg width="64" height="64" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
  <!-- Obsidian Deep Dark Background -->
  <rect width="64" height="64" rx="16" fill="#0A0A0F"/>
  <rect x="1" y="1" width="62" height="62" rx="15" stroke="url(#border_grad)" stroke-width="2"/>
  
  <!-- Outer Glow Filter Ring -->
  <circle cx="32" cy="32" r="22" stroke="url(#pulse_grad)" stroke-width="1" stroke-dasharray="3 3" opacity="0.6"/>

  <!-- Neoclassical Column Capital -->
  <path d="M16 19H48" stroke="#FFFFFF" stroke-width="2.5" stroke-linecap="round"/>
  <path d="M20 15H44" stroke="#E2E8F0" stroke-width="2" stroke-linecap="round"/>
  <path d="M22 23H42" stroke="#CBD5E1" stroke-width="2" stroke-linecap="round"/>

  <!-- Fluted Classical Pillars -->
  <path d="M23 23V43M41 23V43" stroke="#94A3B8" stroke-width="2.5" stroke-linecap="round"/>
  <path d="M29 25V41M35 25V41" stroke="#64748B" stroke-width="1.5" stroke-linecap="round" stroke-dasharray="2 2"/>

  <!-- Column Pedestal / Base -->
  <path d="M20 43H44" stroke="#CBD5E1" stroke-width="2" stroke-linecap="round"/>
  <path d="M16 47H48" stroke="#FFFFFF" stroke-width="2.5" stroke-linecap="round"/>

  <!-- Central Electric Monad Pulse Lightning Bolt -->
  <path d="M33 17L27 31H37L31 47" stroke="#A855F7" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
  <path d="M33 17L27 31H37L31 47" stroke="#C084FC" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
  
  <!-- Core Energy Spark -->
  <circle cx="32" cy="31" r="2.5" fill="#FFFFFF"/>
  <circle cx="32" cy="31" r="6" fill="#A855F7" fill-opacity="0.35"/>

  <defs>
    <linearGradient id="border_grad" x1="0" y1="0" x2="64" y2="64" gradientUnits="userSpaceOnUse">
      <stop stop-color="#A855F7"/>
      <stop offset="0.5" stop-color="#3B82F6"/>
      <stop offset="1" stop-color="#0A0A0F"/>
    </linearGradient>
    <linearGradient id="pulse_grad" x1="10" y1="10" x2="54" y2="54" gradientUnits="userSpaceOnUse">
      <stop stop-color="#C084FC"/>
      <stop offset="1" stop-color="#6366F1"/>
    </linearGradient>
  </defs>
</svg>
